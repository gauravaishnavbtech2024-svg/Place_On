# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed Student Google Email Domain (without @)
NEXT_PUBLIC_ALLOWED_STUDENT_DOMAIN=iujaipur.edu.in

# Comma-separated list of authorized Admin Google emails
ADMIN_EMAILS=placement.head@iujaipur.edu.in,tpo@iujaipur.edu.in

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=PlaceOn <onboarding@resend.dev>

# Public App URL (used in automated email links & PDF resume links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
